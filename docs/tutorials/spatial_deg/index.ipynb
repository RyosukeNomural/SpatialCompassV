    "ubi_in = names[3]\n",
    "print(f\"ubi_in: {len(ubi_in)}\")\n",
    "ubi_out = names[4]\n",
    "print(f\"ubi_out: {len(ubi_out)}\")\n",
    "\n",
    "label_df = annotate_df.iloc[:, :2]\n",
    "label_df.columns = [\"label\", \"gene\"]\n",
    "\n",
    "for index_name in umap_df.index:\n",
